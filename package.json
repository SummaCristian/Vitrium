{
  "name": "liquid-glass-web",
  "version": "0.0.1",
  "description": "A JS/CSS re-implementation of a Liquid Glass-inspired design system for the web.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./core/*": "./src/core/*"
  },
  "scripts": {
    "dev": "vite demo",
    "build:demo": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "preview": "vite preview demo --outDir ../demo-dist",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SummaCristian/Liquid-Glass-Web.git"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  }
}
